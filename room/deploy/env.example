# mihari-room の環境変数 例。実値は書かない。
#
# このファイルをコピーして実値で埋める:
#   sudo install -o root -g mihari -m 600 env.example /etc/mihari-room/env
# systemd の EnvironmentFile= が読む（room/deploy/mihari-room.service）。
# リポジトリには実値をコミットしない。/etc/mihari-room/env は mode 600。

# --- 必須 ---
# ペットの X-Mihari-Token と同じ合言葉。長くて推測不能な値を入れる
MIHARI_ROOM_TOKEN=

# Discord Bot トークン（Discord Developer Portal の Applications から）
DISCORD_BOT_TOKEN=

# 仕事を流す Forum チャンネル ID（数字のみ）
MIHARI_FORUM_CHANNEL_ID=

# 誰の仕事でも止められる人（Discord user id。数字のみ）
MIHARI_OWNER_ID=

# --- ディスク（VPS の専用ユーザー mihari で持つ）---
# 部屋のルート。jobs/ と（実装が進んだら）messages.db, archive/, previews/ を持つ
MIHARI_ROOM_ROOT=/var/lib/mihari/room

# Hermes 専用プロファイルのホーム。state.db（WAL）, config.yaml, .env,
# sessions/, memories/, skills/, hooks/, cron/, plugins/, pairing/ が入る。
# 既定の ~/.hermes には触れない
HERMES_HOME=/var/lib/mihari/hermes

# Hermes を in-process で import する Python（hermes-agent/.venv の python）。
# 省略時は PATH の hermes CLI の shebang から探す。専用ユーザーには必ず明示する
#HERMES_PYTHON=/var/lib/mihari/hermes-agent/.venv/bin/python

# Hermes ソースルート（run_agent.py がある場所）。通常は不要
#HERMES_AGENT_ROOT=/var/lib/mihari/hermes-agent

# mihari-room 自身を動かす Python（room の venv）。systemd の ExecStart が使う
MIHARI_ROOM_PYTHON=/var/lib/mihari/room-venv/bin/python

# --- 聞き口（ローカルバインドのみ。外には Caddy が出す）---
MIHARI_ROOM_HOST=127.0.0.1
MIHARI_ROOM_PORT=8787

# --- プレビュー / アーカイブ（Phase 後半の契約。未実装なら空のまま置く）---
# 静的プレビューの公開ホスト名。API ホストとは別のホスト名にすること（推奨）。
# 未実装の間はコメントのまま
#MIHARI_PREVIEW_BASE_URL=https://preview.room.example.com

# アーカイブ投稿を許すチャンネルの明示的な許可リスト（カンマ区切り）。
# 空のままなら archive は一切投稿しない（opt-in の許可リスト）
#MIHARI_ARCHIVE_CHANNEL_IDS=