# bridge/.env にコピーして使う。このファイル自体は値を入れずにコミットする。
# .env は .gitignore 済み。実際のキーは絶対にコミットしない。

# セリフ生成に使う Claude API のキー。未設定でもアプリは動く(固定文言になる)。
ANTHROPIC_API_KEY=

# 使うモデル。未設定なら claude-haiku-4-5(喋り出しの速さ優先)。
# 品質を上げたいときは claude-opus-5 にする。
MIHARI_LLM_MODEL=

# VOICEVOX エンジンの場所。未設定なら http://127.0.0.1:50021
MIHARI_VOICEVOX_URL=

# VOICEVOX の話者 ID。未設定なら 1。/speakers で一覧を引ける。
MIHARI_VOICEVOX_SPEAKER=

# ---- Discord ----
# Discord Developer Portal (https://discord.com/developers/applications) で
# アプリケーションを作って取得する。未設定でもアプリは動く(晒せなくなるだけ)。
#
# 1. New Application でアプリを作る
# 2. 「General Information」の APPLICATION ID を DISCORD_CLIENT_ID に入れる
# 3. 「Bot」タブで Reset Token して DISCORD_BOT_TOKEN に入れる
#    ※ トークンは認証情報。絶対にコミットしない(bridge/.env は .gitignore 済み)
# 4. アプリの「Discord」タブから招待 URL を開き、自分のサーバに Bot を入れる
# 5. アプリで投稿先チャンネルを選ぶ

DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=

# 投稿先チャンネルの保存場所。未設定なら ~/.mihari
MIHARI_SETTINGS_DIR=
