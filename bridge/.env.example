# bridge/.env にコピーして使う。このファイル自体は値を入れずにコミットする。
# .env は .gitignore 済み。実際のキーは絶対にコミットしない。

# セリフ生成に使う Claude API のキー。未設定でもアプリは動く(固定文言になる)。
ANTHROPIC_API_KEY=

# 使うモデル。未設定なら claude-haiku-4-5(喋り出しの速さ優先)。
# 品質を上げたいときは claude-opus-5 にする。
MIHARI_LLM_MODEL=

# VOICEVOX エンジンの場所。未設定なら http://127.0.0.1:50021
MIHARI_VOICEVOX_URL=

# VOICEVOX の話者 ID。未設定なら 1。/speakers で一覧を引ける。
MIHARI_VOICEVOX_SPEAKER=
